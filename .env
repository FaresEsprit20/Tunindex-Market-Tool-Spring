# ============================================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================================

GOOGLE_CLIENT_ID=***REMOVED-GOOGLE-CLIENT-ID***
GOOGLE_CLIENT_SECRET=***REMOVED-GOOGLE-CLIENT-SECRET***
GOOGLE_REDIRECT_URI=http://localhost:8082/login/oauth2/code/google

# ============================================================
# OAUTH2 RESOURCE SERVER (Your own opaque tokens)
# ============================================================

# Introspection endpoint (your Authorization Server)
OAUTH2_INTROSPECTION_URI=http://localhost:9000/oauth2/introspect
OAUTH2_CLIENT_ID=resource-server
OAUTH2_CLIENT_SECRET=resource-server-secret

# ============================================================
# SECURITY
# ============================================================

